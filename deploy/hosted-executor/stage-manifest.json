{
  "_comment": "Stream 7C - authoritative source->host staging map for the GuvFX hosted signed executor. The deployment packet (Sponsor-gated) copies these files to the host; install_service.ps1 then registers the service. A repository test (backend/hosted_workspace/tests_host_daemon_packaging.py) asserts every source path exists and that the daemon + backend single-source-of-truth modules are covered. NO secrets are staged here - HOSTED_EXECUTOR_* live only in the machine environment.",
  "service": "GuvFXHostedExecutor",
  "install_dirs": {
    "executor_dir": "C:\\GuvFX\\hosted\\executor",
    "lib_dir": "C:\\GuvFX\\hosted\\executor\\lib",
    "hosted_workspace_dir": "C:\\GuvFX\\hosted\\executor\\lib\\hosted_workspace",
    "scripts_dir": "C:\\GuvFX\\hosted\\scripts",
    "observer_dir": "C:\\GuvFX\\observer",
    "winsw_dir": "C:\\GuvFX\\hosted\\executor-winsw",
    "state_dir": "C:\\GuvFX\\hosted\\executor-state"
  },
  "stage": [
    { "src": "deploy/hosted-executor/daemon.py",            "dest": "executor_dir" },
    { "src": "deploy/hosted-executor/daemon_config.py",     "dest": "executor_dir" },
    { "src": "deploy/hosted-executor/nonce_store.py",       "dest": "executor_dir" },
    { "src": "deploy/hosted-executor/primitive_runner.py",  "dest": "executor_dir" },
    { "src": "deploy/hosted-executor/envelope_open.py",     "dest": "executor_dir" },
    { "src": "deploy/hosted-executor/winsw/GuvFXHostedExecutor.xml",            "dest": "winsw_dir_source" },
    { "src": "deploy/hosted-executor/winsw/GuvFXHostedExecutor.supervised.xml", "dest": "winsw_dir_source" },
    { "src": "deploy/hosted-executor/lib/broker_cred_envelope.py", "dest": "lib_dir" },
    { "src": "backend/hosted_workspace/__init__.py",            "dest": "hosted_workspace_dir" },
    { "src": "backend/hosted_workspace/host_protocol.py",       "dest": "hosted_workspace_dir" },
    { "src": "backend/hosted_workspace/host_agent_dispatch.py", "dest": "hosted_workspace_dir" },
    { "src": "backend/terminal_provisioning/windows/run_observer.py", "dest": "observer_dir" },
    { "src": "backend/terminal_provisioning/windows/observer_attach.py", "dest": "observer_dir" }
  ],
  "scripts_from": "backend/terminal_provisioning/windows",
  "scripts": [
    "Provision-GuvfxAccount.ps1",
    "Set-GuvfxWorkspaceAcl.ps1",
    "Populate-GuvfxViewerRuntime.ps1",
    "Set-GuvfxAutoTradingConfig.ps1",
    "Grant-GuvfxRdpAccess.ps1",
    "Set-GuvfxSingleSession.ps1",
    "Set-GuvfxRemoteApp.ps1",
    "Set-GuvfxObserver.ps1",
    "Invoke-GuvfxObserver.ps1",
    "Set-GuvfxAppLockerTenant.ps1",
    "Activate-GuvfxOrderBridge.ps1",
    "Activate-GuvfxTenantBridge.ps1",
    "Relaunch-GuvfxTerminal.ps1",
    "Contain-GuvfxLiveUpdate.ps1",
    "Verify-GuvfxRuntimeBuild.ps1",
    "Verify-GuvfxNativeLauncher.ps1"
  ],
  "_non_primitive_scripts": {
    "_comment": "Staged to the host but NOT signed-executor primitives. Launch-GuvfxTenantTerminal.ps1 is the per-tenant RemoteApp start-program (single-instance launch guard); it is invoked by RemoteApp in the tenant session, never by the executor, so it is intentionally absent from the primitive 'scripts' list. Deployed + AppLocker-allowlisted + RemoteApp-repointed by the arming step, not the executor bundle.",
    "scripts_from": "backend/terminal_provisioning/windows",
    "scripts": ["Launch-GuvfxTenantTerminal.ps1"]
  }
}
