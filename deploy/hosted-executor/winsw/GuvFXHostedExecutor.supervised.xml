<service>
  <!-- SUPERVISED production profile for the GuvFX hosted signed executor (Stream 7C). Automatic + delayed
       start, bounded three-tier onfailure=restart with a permanent floor, launch-proof env marker, rolling
       logs, graceful drain. This SUPERSEDES the DARK install-only GuvFXHostedExecutor.xml.

       Applying this file is a Windows-host mutation and is Sponsor-gated (the separate deployment packet); it
       is NOT applied by the Stream 7C repository packet. Bind is the hosted-executor port only; the beta
       agent (:8791) and the trade bridge (:8788) are never touched.

       SECRETS ARE NOT IN THIS FILE. HOSTED_EXECUTOR_KEYRING / _KEY_ID / _ENC_PRIVKEYS are provisioned as
       MACHINE environment variables via the approved Windows secret mechanism; the WinSW child inherits them
       and the daemon fails closed if any is missing. -->
  <id>GuvFXHostedExecutor</id>
  <name>GuvFX Hosted Signed Executor</name>
  <description>GuvFX hosted signed provisioning executor - narrow, allow-listed, no-RCE host transport for prepare_hosted_slot. Supervised, auto-restart, runs as LocalSystem (ADR-0040; the signed protocol + allow-listed primitives are the security boundary).</description>

  <executable>C:\GuvFX\hosted\executor-venv\Scripts\python.exe</executable>
  <arguments>-u C:\GuvFX\hosted\executor\daemon.py</arguments>
  <workingdirectory>C:\GuvFX\hosted\executor</workingdirectory>

  <!-- Identity: LocalSystem (ADR-0040). WinSW v2.12 ignores <serviceaccount> and installs LocalSystem; the
       sanctioned installer confirms it via `sc config obj= LocalSystem`. Security boundary is the SIGNED
       protocol + allow-listed primitives + Customer-Zero refusal, not the OS token. The least-privilege
       NT SERVICE\GuvFXHostedExecutor account remains selectable via the installer's -RunAsUser. -->
  <serviceaccount>
    <username>LocalSystem</username>
  </serviceaccount>

  <!-- SUPERVISED lifecycle: Automatic + delayed so the executor comes up after boot dependencies (network,
       Tailscale) without racing them. -->
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>

  <!-- Non-secret launch-proof marker the installer substitutes at install time. Never a credential; its value
       is never logged. -->
  <env name="HOSTED_EXECUTOR_SERVICE_IDENTITY" value="GuvFXHostedExecutor" />
  <env name="HOSTED_EXECUTOR_SUPERVISED_TOKEN" value="__SET_AT_INSTALL__" />

  <logpath>C:\GuvFX\hosted\executor-state\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>

  <!-- stoptimeout MUST exceed HOSTED_EXECUTOR_DRAIN_TIMEOUT_S (630s default) - install-time assert. -->
  <stoptimeout>660 sec</stoptimeout>
  <stopparentprocessfirst>true</stopparentprocessfirst>

  <!-- Bounded-backoff restart that NEVER permanently gives up: all three tiers restart, the last governs every
       subsequent failure (permanent floor), delays grow (10s -> 60s -> 300s), and resetfailure clears the
       counter after an hour of clean uptime. -->
  <resetfailure>1 hour</resetfailure>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="60 sec" />
  <onfailure action="restart" delay="300 sec" />
</service>
