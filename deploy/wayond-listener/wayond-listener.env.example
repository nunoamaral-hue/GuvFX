# wayond-listener.env — KEY NAMES ONLY (this is a committed contract, NOT the real file).
#
# The REAL file lives ONLY in the prod secret store (/home/ubuntu/guvfx-prod/wayond-listener.env,
# chmod 600) and is NEVER committed. This example lists the required key NAMES so a config-check
# test (backend/execution/tests_wayond_listener_deploy.py) can prove the committed compose overlay
# still supplies the full certified listener environment, WITHOUT any secret value in Git.
#
# Rule: every line here is `KEY=` with an EMPTY value. Never add a value. Keep in sync with the
# REQUIRED_KEYS constant in tests_wayond_listener_deploy.py (the test fails if a required key is
# missing here or if any value is non-empty).
#
# The listener also loads bridge-agent.env for the Windows-agent token (+ aliases); those keys are
# documented in that file's own example / RUNBOOK, not here.

# --- Database (same as backend) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DJANGO_SECRET_KEY=

# --- Telegram: operational session + FROZEN device fingerprint (from the secret store only) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=
TELEGRAM_DEVICE_MODEL=
TELEGRAM_SYSTEM_VERSION=
TELEGRAM_APP_VERSION=

# --- Functional keys the certified running container carries (omitting any of these on a recreate
#     regresses routing / the drawdown gate — RULE 5/8) ---
MULTI_ACCOUNT_ROUTING_ENABLED=
RISK_MAX_DAILY_DRAWDOWN_ABS=
HOSTED_PERSISTENT_MT5_ENABLED=
GUVFX_AGENT_URL=
GUVFX_WINDOWS_AGENT_BASE_URL=
