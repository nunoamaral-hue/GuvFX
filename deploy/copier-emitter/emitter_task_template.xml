<?xml version="1.0" encoding="UTF-16"?>
<!-- GuvFX Copy Trading host emitter scheduled task - canonical DISABLED/DARK form (ADR-0077).
     The installer produces exactly this shape: Settings.Enabled=false, NO Triggers (never scheduled), no
     RestartOnFailure (never auto-restarts into active emission), LeastPrivilege, start-on-demand only. The
     emitter action runs the gated 'run' mode, which is itself inert unless observation_allowed AND a positive
     fast interval are configured. Placeholders {{...}} are substituted per account at install time. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>GuvFX Copy Trading emitter (account {{ACCOUNT_ID}}) - DISABLED/DARK</Description>
  </RegistrationInfo>
  <Triggers />
  <Principals>
    <Principal id="Author">
      <UserId>{{PRINCIPAL}}</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <Enabled>false</Enabled>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <RestartOnFailure>
      <Interval>PT0M</Interval>
      <Count>0</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{{PYTHON_EXE}}</Command>
      <Arguments>"{{ENTRYPOINT}}" run --config "{{CONFIG_PATH}}"</Arguments>
    </Exec>
  </Actions>
</Task>
