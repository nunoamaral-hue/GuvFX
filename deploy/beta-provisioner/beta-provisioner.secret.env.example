# Provisioner-ONLY secret scope (Phase B) -- TEMPLATE. Copy to beta-provisioner.secret.env and fill.
#
# CONSUMED BY guvfx-beta-provisioner ONLY. The public api.guvfx.com backend MUST NEVER load this file:
# it is referenced solely by docker-compose.beta-provisioner.yml on the guvfx-beta-provisioner service,
# never by the guvfx-backend (api) service. This keeps the HMAC signing secret out of the internet-facing
# backend's environment (RULE 3, least privilege).
#
# TO USE (Sponsor, on the VPS, next to the overlay):
#   cp beta-provisioner.secret.env.example beta-provisioner.secret.env
#   chmod 600 beta-provisioner.secret.env
#   # then fill BETA_AGENT_KEY_ID and BETA_AGENT_KEYRING with the beta agent's matching values.
# The real file (name without .example) is git-ignored and MUST NEVER be committed.

# --- Non-secret: safe to keep here ---------------------------------------------------------------------
# The beta agent's signed management endpoint (Tailscale). Not a secret.
BETA_AGENT_BASE_URL=http://100.79.101.19:8791

# DARK override (non-secret) -- the AUTHORITATIVE arm control for THIS provisioner. 0 = DARK (the worker
# claims nothing). This OVERRIDES the inherited backend value (beta.env sets BETA_RUNTIMES_ENABLED=1),
# because this provisioner-only env_file is appended LAST under `extends` (env_file last-wins). The shared
# backend flag no longer arms this worker. ARM ONLY by changing this 0 -> 1 under explicit Sponsor
# authorisation -- never by touching the shared backend flag.
BETA_RUNTIMES_ENABLED=0

# --- SECRET: leave BLANK in this template; Sponsor fills the real file ONLY ----------------------------
# The active key id -- must EQUAL the beta agent's BETA_AGENT_KEY_ID (the agent Machine env value).
BETA_AGENT_KEY_ID=

# The signing keyring JSON, e.g. {"<key_id>": "<hmac-secret>"} -- must EQUAL the agent's BETA_AGENT_KEYRING.
# NEVER commit a real value. NEVER paste it into chat, logs, CI, or the shared backend env_file.
BETA_AGENT_KEYRING=
