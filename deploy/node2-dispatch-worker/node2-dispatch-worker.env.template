# GuvFX Node-2 dispatch worker — env template. Copy to `node2-dispatch-worker.env` on the host
# (mode 600, owner ubuntu) and fill the placeholders IN THE MAINTENANCE WINDOW. This template is
# committed; the filled `node2-dispatch-worker.env` is git-ignored and NEVER committed.
#
# NO real secret value belongs in this template or in Git. Placeholders are marked <FILL_...>.

# --- worker identity (backend auth: X-Worker-Id + X-Worker-Secret) ---
MT5_WORKER_ID=mt5-node2-order-1
# The node-2 worker secret minted in Boundary A. Source of truth on the host:
#   /home/ubuntu/guvfx-prod/node2-worker-secret.env  ->  GUVFX_NODE_WORKER_SECRET=<value>
# Copy that value here as MT5_WORKER_TOKEN (the worker sends it as X-Worker-Secret; the backend
# compares hash_secret(it) against WorkerIdentity(mt5-node2-order-1).worker_secret_hash).
MT5_WORKER_TOKEN=<FILL_NODE2_WORKER_SECRET>

# --- Django settings prerequisites (the worker runs django.setup()) ---
# Mirror the values the backend/node-1 worker already use on this host. Do NOT invent new values.
DB_HOST=guvfx-postgres
DB_PORT=5432
DB_NAME=guvfx
DB_USER=guvfx
DB_PASSWORD=<FILL_FROM_HOST_DB_CREDENTIAL>
DJANGO_SECRET_KEY=<FILL_FROM_HOST_BACKEND_ENV>
MT5_CRED_FERNET_KEY=<FILL_FROM_HOST_BACKEND_ENV>
DJANGO_ALLOWED_HOSTS=api.guvfx.com,guvfx-backend,localhost,127.0.0.1

# --- optional per-source caps / behaviour (defaults match the deployed worker; override only if instructed) ---
# TI_SOURCE_MAX_LOT=0.40
# MT5_SIGNAL_MAX_AGE_SECONDS=120

# NOTE: the shared inbound agent token (WINDOWS_AGENT_TOKEN / GUVFX_WINDOWS_AGENT_TOKEN /
# GUVFX_AGENT_TOKEN) is supplied via ./bridge-agent.env, NOT here, and MUST be the ROTATED value.
