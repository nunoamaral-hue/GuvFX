{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/dataset_release_signature_v2.schema.json",
  "title": "GuvFX Dataset Release Signature Envelope v2",
  "description": "Algorithm-agile detached signature envelope. Binds a domain separator, release id, manifest digest, contract-bundle digest, validator-bundle digest, producer identity and signing-key identity. The signing boundary here is an INJECTED SYNTHETIC placeholder (algorithm synthetic-placeholder-v0, synthetic:true); no real/operational signing key or algorithm is created or chosen. v2 successor to dataset_release_signature_v1 (preserved, byte-identical). GFX-PKT-TIM-C2, v0.3. Synthetic/design contract.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 }
  },
  "properties": {
    "schema_version": { "const": "2.0" },
    "domain_separator": { "const": "GUVFX-TIM-RELEASE-SIGNATURE-v2" },
    "release_id": { "$ref": "#/definitions/slug" },
    "signed_manifest_path": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$", "maxLength": 512 },
    "manifest_digest": { "$ref": "#/definitions/sha256_hex" },
    "contract_bundle_digest": { "$ref": "#/definitions/sha256_hex" },
    "validator_bundle_digest": { "$ref": "#/definitions/sha256_hex" },
    "producer_identity": { "$ref": "#/definitions/slug" },
    "signing_key_id": { "$ref": "#/definitions/slug" },
    "public_key_fingerprint": { "$ref": "#/definitions/sha256_hex" },
    "algorithm": { "type": "string", "minLength": 1, "maxLength": 64 },
    "signature_scheme": { "const": "detached" },
    "signature_value": { "$ref": "#/definitions/sha256_hex" },
    "synthetic": { "type": "boolean" },
    "created_at_utc": { "$ref": "#/definitions/instant_utc" },
    "key_validity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "not_before_utc": { "$ref": "#/definitions/instant_utc" },
            "not_after_utc": { "$ref": "#/definitions/instant_utc" }
          },
          "required": ["not_before_utc", "not_after_utc"]
        },
        { "type": "null" }
      ]
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version", "domain_separator", "release_id", "signed_manifest_path", "manifest_digest",
    "contract_bundle_digest", "validator_bundle_digest", "producer_identity", "signing_key_id",
    "public_key_fingerprint", "algorithm", "signature_scheme", "signature_value", "synthetic",
    "created_at_utc", "key_validity", "limitations"
  ]
}
