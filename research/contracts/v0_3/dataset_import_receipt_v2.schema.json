{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/dataset_import_receipt_v2.schema.json",
  "title": "GuvFX Dataset Import Receipt v2 (TIM consumer-owned)",
  "description": "A TIM-owned receipt for a consumed GuvFX release. It is written to a CONSUMER-owned namespace, NEVER inside a GuvFX release directory. It is keyed to the immutable release id, manifest digest and signature-envelope digest. States: ACCEPTED (research-admissible), QUARANTINED (retained but not admissible; potentially resolvable), REJECTED (structural/cryptographic/unsupported-major failure; permanent). Receipts are immutable; supersession is recorded FORWARD by writing a NEW receipt. superseded_by_receipt_id therefore cannot be set on the (immutable) receipt it would supersede and is ALWAYS null here (GFX-PKT-TIM-C3 / K-6); a successor pointer belongs on the superseding receipt or the consumer ledger, not retro-fitted onto the superseded one. reason_code is drawn from the versioned machine-readable registry in research/market_data/tim_contracts_v0_3.py (REASON_CODE_REGISTRY); every QUARANTINED reason is resolvable/retryable and every REJECTED reason is permanent (GFX-PKT-TIM-C3 / K-4). v2 successor to dataset_import_receipt_v1 (preserved). GFX-PKT-TIM-C2, v0.3; corrected by GFX-PKT-TIM-C3. Synthetic/design contract.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 }
  },
  "properties": {
    "schema_version": { "const": "2.0" },
    "release_id": { "$ref": "#/definitions/slug" },
    "source_release_manifest_sha256": { "$ref": "#/definitions/sha256_hex" },
    "source_signature_envelope_sha256": { "$ref": "#/definitions/sha256_hex" },
    "consumer_identity": { "$ref": "#/definitions/slug" },
    "consumer_validator_id": { "$ref": "#/definitions/slug" },
    "consumer_validator_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "consumer_validator_digest": { "$ref": "#/definitions/sha256_hex" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signature_verified": { "type": "boolean" },
        "manifest_hashes_verified": { "type": "boolean" },
        "parquet_schema_verified": { "type": "boolean" },
        "evidence_complete": { "type": "boolean" },
        "point_in_time_admissible": { "type": "boolean" }
      },
      "required": ["signature_verified", "manifest_hashes_verified", "parquet_schema_verified", "evidence_complete", "point_in_time_admissible"]
    },
    "import_state": { "type": "string", "enum": ["ACCEPTED", "QUARANTINED", "REJECTED"] },
    "reason_code": {
      "anyOf": [
        { "type": "string", "enum": [
          "signature_invalid", "manifest_hash_mismatch", "unsupported_validator_version",
          "parquet_schema_mismatch", "ndjson_only_not_canonical", "missing_eligibility_evidence",
          "missing_quality_evidence", "timezone_ambiguous", "point_in_time_unavailable",
          "incomplete_release", "supersession_invalid", "path_traversal", "duplicate_candle_key",
          "incomplete_quality_coverage", "row_count_mismatch", "time_range_mismatch",
          "evidence_invalid", "licensing_ambiguous", "ambiguous_instrument_mapping",
          "broker_identity_mismatch", "invalid_signature_envelope", "unsafe_relative_path",
          "duplicate_json_key", "supersession_loop", "invalid_timestamp_metadata",
          "post_ready_mutation", "contract_invalid_manifest", "identity_mismatch",
          "unknown_predecessor", "non_synthetic_in_synthetic", "partial_release_forbidden"
        ] },
        { "type": "null" }
      ]
    },
    "retryable": { "type": "boolean" },
    "research_admissible": { "type": "boolean" },
    "superseded_by_receipt_id": { "anyOf": [{ "$ref": "#/definitions/slug" }, { "type": "null" }] },
    "imported_at_utc": { "$ref": "#/definitions/instant_utc" },
    "synthetic": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version", "release_id", "source_release_manifest_sha256", "source_signature_envelope_sha256",
    "consumer_identity", "consumer_validator_id", "consumer_validator_version", "consumer_validator_digest",
    "checks", "import_state", "reason_code", "retryable", "research_admissible", "superseded_by_receipt_id",
    "imported_at_utc", "synthetic", "limitations"
  ]
}
