{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/dataset_release_manifest_v3.schema.json",
  "title": "GuvFX Dataset Release Manifest v3",
  "description": "Immutable, signed dataset-release manifest. Canonical analytical payload is Parquet (NDJSON only as optional raw evidence; an NDJSON-only canonical release is not import-eligible). Every release file is bound by relative path, media type, byte size, cryptographic digest, logical role and schema/validator version. Source eligibility, broker/server identity, instrument mapping, timezone, licensing, quality, gap and watermark evidence are mandatory hash-bound references. Point-in-time instants are kept separate. READY binds the manifest and signature-envelope digests. Corrections create a new release with a supersession chain; nothing is overwritten. Partial releases are prohibited during the pilot. v3 successor to dataset_release_manifest_v2 (preserved). GFX-PKT-TIM-C2, v0.3. Synthetic/design contract.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "minute_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$" },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rel_path": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$", "maxLength": 512 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "canonical_symbol": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,31}$" },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["algorithm", "value"]
    },
    "release_file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative_path": { "$ref": "#/definitions/rel_path" },
        "media_type": { "type": "string", "enum": ["application/vnd.apache.parquet", "application/x-ndjson", "application/json", "text/plain"] },
        "byte_size": { "type": "integer", "minimum": 0 },
        "digest": { "$ref": "#/definitions/digest" },
        "logical_role": { "type": "string", "enum": ["canonical_parquet", "raw_ndjson", "quality_report", "gap_report", "watermark", "source_eligibility", "broker_server_identity", "instrument_mapping", "timezone_evidence", "licensing", "supersession"] },
        "schema_version": { "type": "string", "minLength": 1, "maxLength": 16 },
        "validator_version": { "type": "string", "minLength": 1, "maxLength": 16 },
        "row_count": { "type": ["integer", "null"], "minimum": 0 }
      },
      "required": ["relative_path", "media_type", "byte_size", "digest", "logical_role", "schema_version", "validator_version", "row_count"]
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": { "type": "string", "minLength": 1, "maxLength": 16 },
        "relative_path": { "$ref": "#/definitions/rel_path" },
        "sha256": { "$ref": "#/definitions/sha256_hex" }
      },
      "required": ["contract_version", "relative_path", "sha256"]
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_timeframe": { "type": "string", "enum": ["M1", "M5", "M15", "M30", "H1", "H4", "D1"] },
        "derivation_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "calendar_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
        "calendar_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "bucket_policy": { "const": "left_closed_right_open" },
        "session_timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
        "dst_policy": { "type": "string", "enum": ["calendar_versioned", "utc_fixed"] },
        "price_basis": { "type": "string", "enum": ["bid"] }
      },
      "required": ["source_timeframe", "derivation_version", "calendar_id", "calendar_version", "bucket_policy", "session_timezone", "dst_policy", "price_basis"]
    }
  },
  "properties": {
    "schema_version": { "const": "3.0" },
    "contract_version": { "const": "0.3" },
    "release_id": { "$ref": "#/definitions/slug" },
    "supersedes_release_id": { "anyOf": [{ "$ref": "#/definitions/slug" }, { "type": "null" }] },
    "supersession": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
            "scope": { "type": "string", "enum": ["FULL", "PARTIAL_WINDOW", "CORRECTION"] },
            "supersession_ref": { "$ref": "#/definitions/evidence_ref" }
          },
          "required": ["reason", "scope", "supersession_ref"]
        },
        { "type": "null" }
      ]
    },
    "source_id": { "$ref": "#/definitions/slug" },
    "canonical_symbol": { "$ref": "#/definitions/canonical_symbol" },
    "broker_native_symbol": { "type": "string", "minLength": 1, "maxLength": 64 },
    "asset_class": { "type": "string", "enum": ["fx", "metal", "index", "commodity", "crypto", "equity"] },
    "timeframe": { "type": "string", "enum": ["M1", "M5", "M15", "M30", "H1", "H4", "D1", "W1"] },
    "representation": { "type": "string", "enum": ["bid_ohlc"] },
    "price_basis": { "type": "string", "enum": ["bid"] },
    "provenance": { "type": "string", "enum": ["NATIVE", "DERIVED"] },
    "derivation": { "anyOf": [{ "$ref": "#/definitions/derivation" }, { "type": "null" }] },
    "canonical_format": { "const": "parquet" },
    "range_start_utc": { "$ref": "#/definitions/minute_utc" },
    "range_end_utc": { "$ref": "#/definitions/minute_utc" },
    "range_semantics": { "const": "[start,end)" },
    "point_in_time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_start_utc": { "$ref": "#/definitions/minute_utc" },
        "event_end_utc": { "$ref": "#/definitions/minute_utc" },
        "source_available_at_utc": { "anyOf": [{ "$ref": "#/definitions/instant_utc" }, { "type": "null" }] },
        "source_availability_classification": { "type": "string", "enum": ["EVIDENCED", "UNKNOWN_RETROSPECTIVE"] },
        "collector_observed_at_utc": { "$ref": "#/definitions/instant_utc" },
        "ingested_at_utc": { "$ref": "#/definitions/instant_utc" },
        "validated_at_utc": { "$ref": "#/definitions/instant_utc" },
        "published_at_utc": { "$ref": "#/definitions/instant_utc" }
      },
      "required": ["event_start_utc", "event_end_utc", "source_available_at_utc", "source_availability_classification", "collector_observed_at_utc", "ingested_at_utc", "validated_at_utc", "published_at_utc"]
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "uniqueness_key": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "files": { "type": "array", "items": { "$ref": "#/definitions/release_file" }, "minItems": 1 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_eligibility": { "$ref": "#/definitions/evidence_ref" },
        "broker_server_identity": { "$ref": "#/definitions/evidence_ref" },
        "instrument_mapping": { "$ref": "#/definitions/evidence_ref" },
        "timezone_evidence": { "$ref": "#/definitions/evidence_ref" },
        "licensing": { "$ref": "#/definitions/evidence_ref" },
        "quality_report": { "$ref": "#/definitions/evidence_ref" },
        "gap_report": { "$ref": "#/definitions/evidence_ref" },
        "watermark": { "$ref": "#/definitions/evidence_ref" }
      },
      "required": ["source_eligibility", "broker_server_identity", "instrument_mapping", "timezone_evidence", "licensing", "quality_report", "gap_report", "watermark"]
    },
    "validator_pinning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "3.0" },
        "validator_id": { "$ref": "#/definitions/slug" },
        "validator_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "validator_digest": { "$ref": "#/definitions/sha256_hex" },
        "compatibility_range": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "required": ["schema_version", "validator_id", "validator_version", "validator_digest", "compatibility_range"]
    },
    "contract_bundle_digest": { "$ref": "#/definitions/sha256_hex" },
    "validator_bundle_digest": { "$ref": "#/definitions/sha256_hex" },
    "release_completeness": { "type": "string", "enum": ["COMPLETE", "INCOMPLETE"] },
    "partial_release_allowed": { "const": false },
    "producer_identity": { "$ref": "#/definitions/slug" },
    "producer_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "signing_key_id": { "$ref": "#/definitions/slug" },
    "signature_path": { "$ref": "#/definitions/rel_path" },
    "ready_marker": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declaration that a signed READY marker is written LAST at ready_marker_path. The READY marker is an EXTERNAL artefact (not a member of files[]) and binds the manifest + signature-envelope digests; it is therefore not content-addressed back into the signed manifest (no circular digest).",
      "properties": {
        "present": { "type": "boolean" },
        "written_last": { "type": "boolean" },
        "ready_marker_path": { "$ref": "#/definitions/rel_path" }
      },
      "required": ["present", "written_last", "ready_marker_path"]
    },
    "licensing_classification": { "type": "string", "enum": ["internal_research_only", "licensed_redistribution", "unlicensed_quarantine"] },
    "synthetic": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version", "contract_version", "release_id", "supersedes_release_id", "supersession",
    "source_id", "canonical_symbol", "broker_native_symbol", "asset_class", "timeframe",
    "representation", "price_basis", "provenance", "derivation", "canonical_format",
    "range_start_utc", "range_end_utc", "range_semantics", "point_in_time", "row_count",
    "uniqueness_key", "files", "evidence", "validator_pinning", "contract_bundle_digest",
    "validator_bundle_digest", "release_completeness", "partial_release_allowed",
    "producer_identity", "producer_version", "signing_key_id", "signature_path", "ready_marker",
    "licensing_classification", "synthetic", "limitations"
  ]
}
