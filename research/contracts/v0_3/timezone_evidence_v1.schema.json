{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/timezone_evidence_v1.schema.json",
  "title": "GuvFX v0.3 Timezone Evidence v1",
  "description": "Formal v0.3 timezone-evidence contract (GFX-PKT-TIM-C3 / ADR-0076, corrective to TIM-P5 finding K-3). Before C3 the release bound an ad-hoc timezone_evidence object with no schema; this gives the timezone_evidence logical role a stable identity, version, issuer, observation/validity timestamps, an evidence digest and an explicit eligibility status. A VERIFIED status requires a real IANA zone; ambiguous, missing, inconsistent or non-VERIFIED evidence quarantines the release. Does NOT modify the frozen 006C broker_timezone_evidence_v1 contract. Synthetic/design contract.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_id": { "$ref": "#/definitions/slug" },
    "issuer": { "$ref": "#/definitions/slug" },
    "timezone_status": { "type": "string", "enum": ["VERIFIED", "INCONCLUSIVE", "CONFLICT"] },
    "source_timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "observed_at_utc": { "$ref": "#/definitions/instant_utc" },
    "valid_from_utc": { "$ref": "#/definitions/instant_utc" },
    "valid_to_utc": { "anyOf": [{ "$ref": "#/definitions/instant_utc" }, { "type": "null" }] },
    "evidence_digest": { "$ref": "#/definitions/sha256_hex" },
    "synthetic": { "type": "boolean" },
    "non_operational": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version", "source_id", "issuer", "timezone_status", "source_timezone",
    "observed_at_utc", "valid_from_utc", "valid_to_utc", "evidence_digest",
    "synthetic", "non_operational", "limitations"
  ]
}
