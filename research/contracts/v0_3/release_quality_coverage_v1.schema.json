{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/release_quality_coverage_v1.schema.json",
  "title": "GuvFX Release Quality Coverage v1",
  "description": "Release-scoped quality-coverage attestation (GFX-PKT-TIM-C3 / ADR-0076, corrective to TIM-P5 finding K-1). Asserts that the quality, gap and watermark evidence bound into a release cover the COMPLETE canonical dataset the release publishes, not merely a sub-window. It binds the release id, canonical file identity and digest, instrument identity, timeframe, the first and last event timestamps, the expected/observed/quality-assessed row counts, partition/file coverage, and the quality/gap/watermark reference digests. It is a member of the SIGNED release set, so it does NOT bind the manifest digest (that would be circular); manifest_digest is therefore null for an in-set attestation and is bound instead by the READY marker and signature envelope. Acceptance requires internally-consistent COMPLETE coverage: a report covering fewer rows or a narrower range than the release fails closed. Additive v0.3 contract; does not modify any v0.2/006C contract. Synthetic/design contract.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "minute_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$" },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rel_path": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$", "maxLength": 512 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "canonical_symbol": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,31}$" },
    "coverage_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative_path": { "$ref": "#/definitions/rel_path" },
        "sha256": { "$ref": "#/definitions/sha256_hex" }
      },
      "required": ["relative_path", "sha256"]
    }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "release_id": { "$ref": "#/definitions/slug" },
    "manifest_digest": {
      "anyOf": [{ "$ref": "#/definitions/sha256_hex" }, { "type": "null" }],
      "description": "Null for an attestation that is itself a member of the signed release set (binding it would be circular); the manifest digest is bound by the READY marker and signature envelope."
    },
    "canonical_symbol": { "$ref": "#/definitions/canonical_symbol" },
    "timeframe": { "type": "string", "enum": ["M1", "M5", "M15", "M30", "H1", "H4", "D1", "W1"] },
    "range_start_utc": { "$ref": "#/definitions/minute_utc" },
    "range_end_utc": { "$ref": "#/definitions/minute_utc" },
    "range_semantics": { "const": "[start,end)" },
    "first_event_start_utc": { "$ref": "#/definitions/minute_utc" },
    "last_event_start_utc": { "$ref": "#/definitions/minute_utc" },
    "expected_row_count": { "type": "integer", "minimum": 0 },
    "observed_row_count": { "type": "integer", "minimum": 0 },
    "quality_assessed_row_count": { "type": "integer", "minimum": 0 },
    "partition_coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scheme": { "const": "single_file_per_release" },
        "files_total": { "type": "integer", "minimum": 1 },
        "files_assessed": { "type": "integer", "minimum": 0 }
      },
      "required": ["scheme", "files_total", "files_assessed"]
    },
    "canonical_file": { "$ref": "#/definitions/coverage_ref" },
    "quality_report_ref": { "$ref": "#/definitions/coverage_ref" },
    "gap_report_ref": { "$ref": "#/definitions/coverage_ref" },
    "watermark_ref": { "$ref": "#/definitions/coverage_ref" },
    "completeness_status": { "type": "string", "enum": ["COMPLETE", "INCOMPLETE"] },
    "synthetic": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version", "release_id", "manifest_digest", "canonical_symbol", "timeframe",
    "range_start_utc", "range_end_utc", "range_semantics", "first_event_start_utc", "last_event_start_utc",
    "expected_row_count", "observed_row_count", "quality_assessed_row_count", "partition_coverage",
    "canonical_file", "quality_report_ref", "gap_report_ref", "watermark_ref",
    "completeness_status", "synthetic", "limitations"
  ]
}
