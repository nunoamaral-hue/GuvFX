{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/licensing_v1.schema.json",
  "title": "GuvFX v0.3 Licensing and Permitted-Use Evidence v1",
  "description": "Formal v0.3 licensing / permitted-use contract (GFX-PKT-TIM-C3 / ADR-0076, corrective to TIM-P5 finding K-3). Before C3 the release bound an ad-hoc licensing object with no schema. This gives the licensing logical role a stable identity, version, issuer, validity timestamps and an evidence digest, and makes the permitted-use eligibility explicitly checkable. internal_research_only is expressible and is the only classification a synthetic record may carry. Ambiguous (unlicensed_quarantine), missing or inconsistent licensing quarantines the release. Does NOT modify any frozen contract. Synthetic/design contract.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_id": { "$ref": "#/definitions/slug" },
    "issuer": { "$ref": "#/definitions/slug" },
    "licensing_classification": { "type": "string", "enum": ["internal_research_only", "licensed_redistribution", "unlicensed_quarantine"] },
    "licensing_reference": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 512 }, { "type": "null" }] },
    "permitted_use": { "type": "string", "enum": ["internal_research_only", "licensed_redistribution"] },
    "valid_from_utc": { "$ref": "#/definitions/instant_utc" },
    "valid_to_utc": { "anyOf": [{ "$ref": "#/definitions/instant_utc" }, { "type": "null" }] },
    "evidence_digest": { "$ref": "#/definitions/sha256_hex" },
    "synthetic": { "type": "boolean" },
    "non_operational": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version", "source_id", "issuer", "licensing_classification", "licensing_reference",
    "permitted_use", "valid_from_utc", "valid_to_utc", "evidence_digest",
    "synthetic", "non_operational", "limitations"
  ]
}
