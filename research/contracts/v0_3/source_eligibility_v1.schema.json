{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/source_eligibility_v1.schema.json",
  "title": "GuvFX Source Eligibility Evidence v1",
  "description": "Governed, non-secret evidence that a market-data source is eligible to produce a release: broker/server identity, a non-secret source-account reference, licensing/permitted-use approval, and capacity certification. Ambiguous/missing approval quarantines the release. A synthetic record MUST mark synthetic:true and non_operational:true and classify as internal_research_only; no real broker-licensing assertion may be invented. GFX-PKT-TIM-C2, v0.3. Synthetic/design contract.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_id": { "$ref": "#/definitions/slug" },
    "broker_id": { "anyOf": [{ "$ref": "#/definitions/slug" }, { "type": "null" }] },
    "server_identity": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source_account_reference": { "type": "string", "minLength": 1, "maxLength": 160 },
    "eligibility_status": { "type": "string", "enum": ["APPROVED", "PENDING", "DENIED"] },
    "licensing_classification": { "type": "string", "enum": ["internal_research_only", "licensed_redistribution", "unlicensed_quarantine"] },
    "licensing_reference": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 512 }, { "type": "null" }] },
    "permitted_use": { "type": "string", "enum": ["internal_research_only", "licensed_redistribution"] },
    "capacity_certified": { "type": "boolean" },
    "capacity_certification_ref": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 512 }, { "type": "null" }] },
    "synthetic": { "type": "boolean" },
    "non_operational": { "type": "boolean" },
    "approved_at_utc": { "anyOf": [{ "$ref": "#/definitions/instant_utc" }, { "type": "null" }] },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version", "source_id", "broker_id", "server_identity", "source_account_reference",
    "eligibility_status", "licensing_classification", "licensing_reference", "permitted_use",
    "capacity_certified", "capacity_certification_ref", "synthetic", "non_operational",
    "approved_at_utc", "limitations"
  ]
}
