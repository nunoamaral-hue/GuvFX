{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/release_supersession_v1.schema.json",
  "title": "GuvFX Release Supersession v1",
  "description": "An immutable release is never overwritten or deleted. A correction creates a NEW immutable release whose manifest references the superseded release through this record. A release may not supersede itself (loop guard). GFX-PKT-TIM-C2, v0.3. Synthetic/design contract.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "minute_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "release_id": { "$ref": "#/definitions/slug" },
    "supersedes_release_id": { "$ref": "#/definitions/slug" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "scope": { "type": "string", "enum": ["FULL", "PARTIAL_WINDOW", "CORRECTION"] },
    "correction_window": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "range_start_utc": { "$ref": "#/definitions/minute_utc" },
            "range_end_utc": { "$ref": "#/definitions/minute_utc" }
          },
          "required": ["range_start_utc", "range_end_utc"]
        },
        { "type": "null" }
      ]
    },
    "created_at_utc": { "$ref": "#/definitions/instant_utc" },
    "synthetic": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["schema_version", "release_id", "supersedes_release_id", "reason", "scope", "correction_window", "created_at_utc", "synthetic", "limitations"]
}
