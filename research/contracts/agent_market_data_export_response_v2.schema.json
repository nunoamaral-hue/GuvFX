{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/agent_market_data_export_response_v2.schema.json",
  "title": "GuvFX Agent Market-Data Export Response v2",
  "description": "Read-only MT5 market-data export response (v2). Carries the exported NATIVE M1 bid bars with half-open event intervals plus the source-availability and collector-observation lineage timestamps. No credentials. Synthetic/design contract under GFX-PKT-TIM-C1; no live call is made.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "minute_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "scope_slug": { "type": "string", "pattern": "^(?=.*[a-z])[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canonical_symbol": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,31}$" },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_start_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$" },
        "event_end_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$" },
        "open": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "close": { "type": "number" },
        "volume": { "type": ["number", "null"] }
      },
      "required": ["event_start_utc", "event_end_utc", "open", "high", "low", "close", "volume"]
    }
  },
  "properties": {
    "schema_version": { "const": "2.0" },
    "request_id": { "$ref": "#/definitions/sha256_hex" },
    "source_id": { "$ref": "#/definitions/slug" },
    "account_scope": { "$ref": "#/definitions/scope_slug" },
    "canonical_symbol": { "$ref": "#/definitions/canonical_symbol" },
    "broker_native_symbol": { "type": "string", "minLength": 1, "maxLength": 64 },
    "timeframe": { "type": "string", "enum": ["M1"] },
    "representation": { "type": "string", "enum": ["bid_ohlc"] },
    "price_basis": { "type": "string", "enum": ["bid"] },
    "provenance": { "const": "NATIVE", "description": "A direct export is always NATIVE; derived candles are produced downstream, never here." },
    "range_start_utc": { "$ref": "#/definitions/minute_utc" },
    "range_end_utc": { "$ref": "#/definitions/minute_utc" },
    "range_semantics": { "const": "[start,end)" },
    "source_timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source_available_at_utc": { "$ref": "#/definitions/instant_utc", "description": "When the source made the data available (≈ bar close at the source)." },
    "collector_observed_at_utc": { "$ref": "#/definitions/instant_utc", "description": "When the GuvFX collector observed/polled it; must be >= source_available_at_utc." },
    "bar_count": { "type": "integer", "minimum": 0 },
    "bars": { "type": "array", "items": { "$ref": "#/definitions/bar" } },
    "raw_object_sha256": { "$ref": "#/definitions/sha256_hex" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version", "request_id", "source_id", "account_scope", "canonical_symbol",
    "broker_native_symbol", "timeframe", "representation", "price_basis", "provenance",
    "range_start_utc", "range_end_utc", "range_semantics", "source_timezone",
    "source_available_at_utc", "collector_observed_at_utc", "bar_count", "bars",
    "raw_object_sha256", "limitations"
  ]
}
