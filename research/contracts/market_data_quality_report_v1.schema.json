{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/market_data_quality_report_v1.schema.json",
  "title": "GuvFX Market-Data Quality Report v1",
  "description": "Quality evaluation of a market-data range: completeness, interval ordering, duplicates/overlaps, OHLC invariants and finiteness, with explicit quarantine reasons. A PASS requires full completeness and zero violations; any ambiguity quarantines. Synthetic/design contract under GFX-PKT-TIM-C1.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "minute_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "canonical_symbol": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,31}$" }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_id": { "$ref": "#/definitions/slug" },
    "canonical_symbol": { "$ref": "#/definitions/canonical_symbol" },
    "timeframe": { "type": "string", "enum": ["M1", "M5", "M15", "M30", "H1", "H4", "D1", "W1"] },
    "representation": { "type": "string", "enum": ["bid_ohlc"] },
    "price_basis": { "type": "string", "enum": ["bid"] },
    "provenance": { "type": "string", "enum": ["NATIVE", "DERIVED"] },
    "range_start_utc": { "$ref": "#/definitions/minute_utc" },
    "range_end_utc": { "$ref": "#/definitions/minute_utc" },
    "range_semantics": { "const": "[start,end)" },
    "expected_bar_count": { "type": "integer", "minimum": 0 },
    "observed_bar_count": { "type": "integer", "minimum": 0 },
    "duplicate_count": { "type": "integer", "minimum": 0 },
    "out_of_order_count": { "type": "integer", "minimum": 0 },
    "overlap_count": { "type": "integer", "minimum": 0 },
    "ohlc_violation_count": { "type": "integer", "minimum": 0 },
    "non_finite_count": { "type": "integer", "minimum": 0 },
    "gap_count": { "type": "integer", "minimum": 0 },
    "quality_status": { "type": "string", "enum": ["PASS", "QUARANTINE", "FAIL"] },
    "quarantine_reasons": { "type": "array", "items": { "type": "string" } },
    "evaluated_at_utc": { "$ref": "#/definitions/instant_utc" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version", "source_id", "canonical_symbol", "timeframe", "representation", "price_basis",
    "provenance", "range_start_utc", "range_end_utc", "range_semantics", "expected_bar_count",
    "observed_bar_count", "duplicate_count", "out_of_order_count", "overlap_count",
    "ohlc_violation_count", "non_finite_count", "gap_count", "quality_status",
    "quarantine_reasons", "evaluated_at_utc", "limitations"
  ]
}
