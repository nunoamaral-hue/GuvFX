{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/agent_market_data_export_request_v2.schema.json",
  "title": "GuvFX Agent Market-Data Export Request v2",
  "description": "Read-only MT5 market-data export request. v2 successor to agent_history_export_request_v1 (which is preserved byte-identical); adds canonical/native instrument identity and explicit price basis. Contains NO login, account number, password, token or server credential. Synthetic/design contract under GFX-PKT-TIM-C1; no live call is made.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "minute_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "scope_slug": { "type": "string", "pattern": "^(?=.*[a-z])[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canonical_symbol": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,31}$" }
  },
  "properties": {
    "schema_version": { "const": "2.0" },
    "operation": { "const": "copy_rates_range" },
    "source_id": { "$ref": "#/definitions/slug" },
    "account_scope": { "$ref": "#/definitions/scope_slug" },
    "canonical_symbol": { "$ref": "#/definitions/canonical_symbol" },
    "broker_native_symbol": { "type": "string", "minLength": 1, "maxLength": 64 },
    "timeframe": { "type": "string", "enum": ["M1"] },
    "representation": { "type": "string", "enum": ["bid_ohlc"] },
    "price_basis": { "type": "string", "enum": ["bid"] },
    "range_start_utc": { "$ref": "#/definitions/minute_utc" },
    "range_end_utc": { "$ref": "#/definitions/minute_utc" },
    "range_semantics": { "const": "[start,end)" },
    "request_id": { "$ref": "#/definitions/sha256_hex" }
  },
  "required": [
    "schema_version", "operation", "source_id", "account_scope", "canonical_symbol",
    "broker_native_symbol", "timeframe", "representation", "price_basis",
    "range_start_utc", "range_end_utc", "range_semantics", "request_id"
  ]
}
