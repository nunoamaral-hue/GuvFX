{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/market_data_gap_v1.schema.json",
  "title": "GuvFX Market-Data Gap v1",
  "description": "A declared gap in a market-data series and its repair lineage. Gap repair creates NEW immutable evidence; it never overwrites or invents market data. Synthetic/design contract under GFX-PKT-TIM-C1.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "minute_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$" },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rel_path": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$", "maxLength": 512 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "canonical_symbol": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,31}$" },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repaired_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
        "repair_raw_object_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "repair_evidence_path": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$", "maxLength": 512 },
        "supersedes_gap_id": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] }
      },
      "required": ["repaired_at_utc", "repair_raw_object_sha256", "repair_evidence_path", "supersedes_gap_id"]
    }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "gap_id": { "$ref": "#/definitions/sha256_hex" },
    "source_id": { "$ref": "#/definitions/slug" },
    "canonical_symbol": { "$ref": "#/definitions/canonical_symbol" },
    "timeframe": { "type": "string", "enum": ["M1", "M5", "M15", "M30", "H1", "H4", "D1", "W1"] },
    "representation": { "type": "string", "enum": ["bid_ohlc"] },
    "gap_start_utc": { "$ref": "#/definitions/minute_utc" },
    "gap_end_utc": { "$ref": "#/definitions/minute_utc" },
    "range_semantics": { "const": "[start,end)" },
    "gap_state": { "type": "string", "enum": ["DECLARED", "REPAIRED", "UNREPAIRABLE"] },
    "declared_at_utc": { "$ref": "#/definitions/instant_utc" },
    "reason": { "type": "string", "minLength": 1 },
    "repair": {
      "anyOf": [{ "$ref": "#/definitions/repair" }, { "type": "null" }],
      "description": "Non-null ONLY when gap_state is REPAIRED (new immutable repair evidence); null for DECLARED/UNREPAIRABLE."
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version", "gap_id", "source_id", "canonical_symbol", "timeframe", "representation",
    "gap_start_utc", "gap_end_utc", "range_semantics", "gap_state", "declared_at_utc", "reason",
    "repair", "limitations"
  ]
}
