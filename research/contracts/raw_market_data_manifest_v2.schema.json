{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://guvfx.local/schema/raw_market_data_manifest_v2.schema.json",
  "title": "GuvFX Raw Market-Data Manifest v2",
  "description": "Manifest for an immutable raw market-data object (accepted or quarantined). v2 successor to raw_market_data_manifest_v1 (preserved byte-identical); adds canonical/native identity, provenance and the full source/observation/ingestion/validation time chain. All paths are root-relative; absolute paths are forbidden. Synthetic/design contract under GFX-PKT-TIM-C1.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "instant_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "instant_utc_nullable": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "minute_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$" },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rel_path": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$", "maxLength": 512 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "scope_slug": { "type": "string", "pattern": "^(?=.*[a-z])[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "canonical_symbol": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,31}$" }
  },
  "properties": {
    "schema_version": { "const": "2.0" },
    "raw_object_id": { "$ref": "#/definitions/sha256_hex" },
    "object_state": { "type": "string", "enum": ["ACCEPTED", "QUARANTINED"] },
    "source_id": { "$ref": "#/definitions/slug" },
    "account_scope": { "$ref": "#/definitions/scope_slug" },
    "canonical_symbol": { "$ref": "#/definitions/canonical_symbol" },
    "broker_native_symbol": { "type": "string", "minLength": 1, "maxLength": 64 },
    "asset_class": { "type": "string", "enum": ["fx", "metal", "index", "commodity", "crypto", "equity"] },
    "timeframe": { "type": "string", "enum": ["M1"] },
    "provenance": { "const": "NATIVE" },
    "representation": { "type": "string", "enum": ["bid_ohlc"] },
    "price_basis": { "type": "string", "enum": ["bid"] },
    "range_start_utc": { "$ref": "#/definitions/minute_utc" },
    "range_end_utc": { "$ref": "#/definitions/minute_utc" },
    "range_semantics": { "const": "[start,end)" },
    "source_timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "event_start_utc": { "$ref": "#/definitions/minute_utc" },
    "event_end_utc": { "$ref": "#/definitions/minute_utc" },
    "source_available_at_utc": { "$ref": "#/definitions/instant_utc" },
    "collector_observed_at_utc": { "$ref": "#/definitions/instant_utc" },
    "ingested_at_utc": { "$ref": "#/definitions/instant_utc" },
    "validated_at_utc": { "$ref": "#/definitions/instant_utc_nullable", "description": "Null when the object was quarantined before validation." },
    "request_schema_id": { "type": "string", "minLength": 1 },
    "response_schema_id": { "type": "string", "minLength": 1 },
    "request_sha256": { "$ref": "#/definitions/sha256_hex" },
    "response_sha256": { "$ref": "#/definitions/sha256_hex" },
    "request_path": { "$ref": "#/definitions/rel_path" },
    "response_path": { "$ref": "#/definitions/rel_path" },
    "manifest_path": { "$ref": "#/definitions/rel_path" },
    "code_commit": { "type": "string", "minLength": 1 },
    "timezone_status": { "type": "string", "enum": ["NOT_EVALUATED", "VERIFIED", "INCONCLUSIVE", "CONFLICT"] },
    "row_count": { "type": "integer", "minimum": 0 },
    "file_size_bytes": { "type": "integer", "minimum": 0 },
    "content_sha256": { "$ref": "#/definitions/sha256_hex" },
    "quarantine_reason": { "type": ["string", "null"] },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version", "raw_object_id", "object_state", "source_id", "account_scope",
    "canonical_symbol", "broker_native_symbol", "asset_class", "timeframe", "provenance",
    "representation", "price_basis", "range_start_utc", "range_end_utc", "range_semantics",
    "source_timezone", "event_start_utc", "event_end_utc", "source_available_at_utc",
    "collector_observed_at_utc", "ingested_at_utc", "validated_at_utc", "request_schema_id",
    "response_schema_id", "request_sha256", "response_sha256", "request_path", "response_path",
    "manifest_path", "code_commit", "timezone_status", "row_count", "file_size_bytes",
    "content_sha256", "quarantine_reason", "limitations"
  ]
}
